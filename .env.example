NODE_ENV=development
PORT=3000

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=turismo

# --- JWT (panel admin) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# --- JWT (clientes) ---
JWT_CLIENTE_SECRET=
JWT_CLIENTE_REFRESH_SECRET=
JWT_CLIENTE_ACCESS_EXPIRES=15m
JWT_CLIENTE_REFRESH_EXPIRES=7d

CORS_ORIGIN=http://localhost:5173

# URL pública del frontend, usada para construir enlaces que van por
# correo (por ejemplo el de "recuperar contraseña").
FRONTEND_URL=http://localhost:5173

# --- Correo transaccional ---
# Si se dejan vacías, EmailService (vía la cola 'email') solo loguea el
# correo en vez de enviarlo (modo simulado, útil en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Turismo <no-responder@tudominio.cl>"
ADMIN_NOTIFICATION_EMAIL=

# --- WhatsApp Business Cloud API (Meta) ---
# Si se dejan vacías, el aviso se loguea (modo simulado) en vez de enviarse.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_API_VERSION=v21.0

# --- Transbank Webpay Plus (pago con tarjeta) ---
# Si se dejan vacías, se usan las credenciales de INTEGRACIÓN (pruebas)
# que Transbank publica para todos los desarrolladores — el flujo de
# pago completo funciona igual, pero con tarjetas de prueba y sin mover
# dinero real. Para producción, tramita tu comercio en
# https://www.transbankdevelopers.cl y reemplaza estas dos por las
# credenciales reales que te entreguen.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
# integration | production
TRANSBANK_ENVIRONMENT=integration
# URL pública del backend (sin barra final), para que Transbank pueda
# redirigir al cliente de vuelta tras pagar. En local no importa; en
# producción debe ser la URL real donde corre este backend.
BACKEND_PUBLIC_URL=http://localhost:3000

# --- Redis (caché + BullMQ) ---
# En Railway/Render, agrega el plugin/servicio de Redis y copia la URL que
# te entregan acá (formato: redis://default:password@host:puerto).
# Si se deja vacía, se usa REDIS_HOST/REDIS_PORT/REDIS_PASSWORD por separado.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Cloudinary (almacenamiento de imágenes) ---
# Créalas gratis en https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Logging ---
# fatal | error | warn | info | debug | trace. Si se deja vacía: "debug" en
# desarrollo, "info" en producción.
LOG_LEVEL=

# --- Seed del admin inicial (npm run seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NOMBRE=

# --- Otros ---
BCRYPT_ROUNDS=10
